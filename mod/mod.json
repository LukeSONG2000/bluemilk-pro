{
  "id": "bluemilk.pro",
  "name": "BlueMilk Pro",
  "publisher": "BlueMilk project",
  "version": "0.2.3",
  "sdkVersion": 2,
  "gameProfile": "swgoh-0.40.7",
  "capabilities": [
    "battle.information.read",
    "native.ui"
  ],
  "presentations": [
    "desktop",
    "cli"
  ],
  "dependencies": [],
  "conflicts": [
    "bluemilk.information"
  ],
  "entry": "main.js",
  "description": "原版信息辅助与连接修复。",
  "repository": "https://github.com/LukeSONG2000/bluemilk-pro",
  "configuration": {
    "version": 1,
    "fields": [
      {
        "key": "targetGap",
        "label": "右上角数值与色条间距",
        "type": "integer",
        "minimum": 8,
        "maximum": 48,
        "default": 16
      },
      {
        "key": "eaConnectivityMode",
        "label": "EA连接修复模式",
        "type": "string",
        "maxLength": 16,
        "default": "extended",
        "options": [
          "original",
          "extended",
          "skip"
        ]
      }
    ]
  },
  "desktop": {
    "version": 1,
    "query": "view",
    "refreshMs": 1000,
    "features": [
      {
        "id": "information",
        "title": "信息拓展",
        "kind": "toggle",
        "binding": "information",
        "command": "set-information",
        "home": true,
        "description": "在战斗目标组件和战斗效果详情弹窗显示角色生命值/护盾的绝对值、技能 CD、状态效果回合数。"
      },
      {
        "id": "attributes",
        "title": "实时属性",
        "kind": "table",
        "binding": "attributes",
        "home": true,
        "columns": [
          {
            "key": "name",
            "title": "属性"
          },
          {
            "key": "initial",
            "title": "初始"
          },
          {
            "key": "current",
            "title": "当前 (变化)"
          }
        ],
        "description": "显示角色进入战斗时的属性面板和当前属性面板。",
        "floating": {
          "background": "#ED192940",
          "foreground": "#FFFFFFFF",
          "border": "#FF52CCF6",
          "fontFamily": "MYingHei_18030_C",
          "fontSize": 16,
          "fontAsset": "MYingHei_18030_C-Medium"
        }
      },
      {
        "id": "connectivity",
        "title": "EA 连接修复",
        "description": "延长或跳过官网联网预检，保留 EA 平台认证和原版领取流程。",
        "kind": "select",
        "binding": "connectivity",
        "command": "set-connectivity",
        "home": true,
        "options": [
          {
            "value": "original",
            "label": "原版（2 秒）"
          },
          {
            "value": "extended",
            "label": "延长至 15 秒"
          },
          {
            "value": "skip",
            "label": "跳过官网预检"
          }
        ]
      }
    ]
  },
  "icon": "icon.png"
}
