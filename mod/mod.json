{
  "id": "bluemilk.pro",
  "name": "BlueMilk Pro",
  "version": "1.0.0",
  "sdkVersion": 2,
  "gameProfile": "swgoh-0.40.7",
  "capabilities": [
    "battle.information.read",
    "native.ui"
  ],
  "presentations": [
    "desktop",
    "cli"
  ],
  "dependencies": [],
  "conflicts": [
    "bluemilk.information"
  ],
  "entry": "main.js",
  "description": "原版信息辅助与商店购买失败修复。",
  "repository": "https://github.com/LukeSONG2000/bluemilk-pro",
  "configuration": {
    "version": 1,
    "fields": [
      {
        "key": "targetGap",
        "label": "右上角数值与色条间距",
        "type": "integer",
        "minimum": 8,
        "maximum": 48,
        "default": 16
      },
      {
        "key": "purchaseFailureFix",
        "label": "商店购买失败修复",
        "type": "boolean",
        "default": true
      }
    ]
  },
  "desktop": {
    "version": 1,
    "query": "view",
    "refreshMs": 1000,
    "features": [
      {
        "id": "information",
        "title": "信息拓展",
        "kind": "toggle",
        "binding": "information",
        "command": "set-information",
        "home": true,
        "description": "在战斗目标组件和战斗效果详情弹窗显示角色生命值/护盾的绝对值、技能 CD、状态效果回合数。"
      },
      {
        "id": "attributes",
        "title": "实时属性",
        "kind": "table",
        "binding": "attributes",
        "home": true,
        "columns": [
          {
            "key": "name",
            "title": "属性"
          },
          {
            "key": "initial",
            "title": "初始"
          },
          {
            "key": "current",
            "title": "当前 (变化)"
          }
        ],
        "description": "显示角色进入战斗时的属性面板和当前属性面板。",
        "floating": {
          "background": "#ED192940",
          "foreground": "#FFFFFFFF",
          "border": "#FF52CCF6",
          "fontFamily": "MYingHei_18030_C",
          "fontSize": 16,
          "fontAsset": "MYingHei_18030_C-Medium"
        }
      },
      {
        "id": "connectivity",
        "title": "商店购买失败修复",
        "description": "修复EA服务器连接超时，导致商店购买失败需要重新启动的问题。",
        "kind": "toggle",
        "binding": "connectivity",
        "command": "set-connectivity",
        "home": true
      }
    ]
  },
  "icon": "icon.png",
  "author": "LukeSONG2000",
  "updates": {
    "provider": "github",
    "asset": "BlueMilk-Pro-{version}.bluemilk"
  },
  "publishedAt": "2026-10-22T08:24:09Z"
}
